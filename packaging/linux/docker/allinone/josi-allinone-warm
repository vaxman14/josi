#!/bin/bash
# Waits for Ollama, loads the model once (so the first real question is not slow)
# and says where it is running.
set -u
if [ -c /dev/console ]; then exec > >(tee /dev/console) 2>&1; fi
i=0
until curl -fsS http://127.0.0.1:11434/api/version >/dev/null 2>&1; do
  i=$((i + 1))
  [ "$i" -lt 180 ] || { echo "Ollama did not answer within three minutes."; exit 1; }
  sleep 1
done
echo "Ollama is up. Loading the Josi model (this can take a minute)..."
if ! curl -fsS --max-time 900 http://127.0.0.1:11434/api/generate \
     -d '{"model":"josi-qwen3.5-9b","prompt":"hi","stream":false,"keep_alive":-1,"options":{"num_predict":1}}' >/dev/null; then
  echo "The model did not load."; exit 1
fi
where=$(curl -fsS http://127.0.0.1:11434/api/ps | jq -r '.models[0] | if (.size_vram // 0) > 0 and (.size_vram >= .size) then "the GPU" elif (.size_vram // 0) > 0 then "the GPU and the CPU (it does not all fit on the GPU)" else "the CPU" end' 2>/dev/null || echo unknown)
echo "The Josi model is loaded and running on ${where}."
