#!/bin/bash
# Healthy only when both Ollama and Josi answer.
curl -fsS --max-time 5 http://127.0.0.1:11434/api/version >/dev/null || { echo "ollama is not answering"; exit 1; }
curl -fsS --max-time 5 http://127.0.0.1:8080/ready >/dev/null || { echo "josi is not answering"; exit 1; }
# Not healthy until first boot has finished (the backup folder and the key helper are set up in its last seconds).
systemctl is-active --quiet josi-firstboot.service || { echo "josi is still being set up"; exit 1; }
echo ok
